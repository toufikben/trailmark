CREATE TABLE activity (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  uuid TEXT NOT NULL,
  sport TEXT NOT NULL,
  start_wall_millis INTEGER NOT NULL,
  elapsed_nanos INTEGER NOT NULL DEFAULT 0,
  distance_m REAL NOT NULL DEFAULT 0,
  climb_m REAL NOT NULL DEFAULT 0,
  fix_count INTEGER NOT NULL DEFAULT 0,
  rejected_count INTEGER NOT NULL DEFAULT 0,
  mock_detected INTEGER NOT NULL DEFAULT 0,
  is_deleted INTEGER NOT NULL DEFAULT 0,
  server_uuid TEXT,
  updated_at INTEGER,
  weather_temp_c REAL,
  weather_wind_kmh REAL,
  weather_wind_deg INTEGER,
  weather_code INTEGER
);

CREATE TABLE track_point (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  activity_id INTEGER NOT NULL REFERENCES activity(id),
  time_nanos INTEGER NOT NULL,
  lat REAL NOT NULL,
  lon REAL NOT NULL,
  alt_gnss REAL,
  accuracy_m REAL,
  speed_mps REAL,
  bearing_deg REAL,
  waypoint_type TEXT NOT NULL
);

CREATE TABLE track_state (
  key TEXT NOT NULL PRIMARY KEY,
  activity_id INTEGER NOT NULL,
  last_time_nanos INTEGER NOT NULL,
  last_lat REAL NOT NULL,
  last_lon REAL NOT NULL,
  last_accuracy_m REAL,
  last_type TEXT NOT NULL,
  distance_m REAL NOT NULL,
  last_elapsed_nanos INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE app_flag (
  key TEXT NOT NULL PRIMARY KEY,
  value INTEGER NOT NULL
);

CREATE TABLE media (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  activity_id INTEGER NOT NULL REFERENCES activity(id),
  kind TEXT NOT NULL,
  file_path TEXT NOT NULL,
  lat REAL,
  lon REAL,
  bearing_deg REAL,
  distance_m REAL NOT NULL DEFAULT 0,
  elapsed_nanos INTEGER NOT NULL DEFAULT 0,
  created_wall_millis INTEGER NOT NULL,
  duration_ms INTEGER,
  caption TEXT
);

CREATE TABLE segment (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  start_lat REAL NOT NULL,
  start_lon REAL NOT NULL,
  end_lat REAL NOT NULL,
  end_lon REAL NOT NULL,
  created_wall_millis INTEGER NOT NULL
);

CREATE TABLE segment_effort (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  segment_id INTEGER NOT NULL REFERENCES segment(id),
  activity_id INTEGER NOT NULL REFERENCES activity(id),
  elapsed_nanos INTEGER NOT NULL,
  created_wall_millis INTEGER NOT NULL
);

insertActivity:
INSERT INTO activity(uuid, sport, start_wall_millis) VALUES (?, ?, ?);

lastId:
SELECT last_insert_rowid();

insertPoint:
INSERT INTO track_point(activity_id, time_nanos, lat, lon, alt_gnss, accuracy_m, speed_mps, bearing_deg, waypoint_type)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

countPoints:
SELECT count(*) FROM track_point WHERE activity_id = ?;

finishActivity:
UPDATE activity SET elapsed_nanos = ?, distance_m = ?, fix_count = ?, rejected_count = ?, mock_detected = ? WHERE id = ?;

selectActivity:
SELECT * FROM activity WHERE id = ? LIMIT 1;

selectPoints:
SELECT * FROM track_point WHERE activity_id = ? ORDER BY id ASC;

pointsAfter:
SELECT * FROM track_point WHERE activity_id = ? AND id > ? ORDER BY id ASC;

listActivities:
SELECT * FROM activity WHERE is_deleted = 0 ORDER BY start_wall_millis DESC, id DESC;

upsertResume:
INSERT OR REPLACE INTO track_state(key, activity_id, last_time_nanos, last_lat, last_lon, last_accuracy_m, last_type, distance_m, last_elapsed_nanos)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectResume:
SELECT * FROM track_state WHERE key = 'resume' LIMIT 1;

clearResume:
DELETE FROM track_state WHERE key = 'resume' AND activity_id = ?;

getFlag:
SELECT value FROM app_flag WHERE key = ? LIMIT 1;

setFlag:
INSERT OR REPLACE INTO app_flag(key, value) VALUES (?, ?);

insertMedia:
INSERT INTO media(activity_id, kind, file_path, lat, lon, bearing_deg, distance_m, elapsed_nanos, created_wall_millis, duration_ms, caption)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

listMedia:
SELECT * FROM media WHERE activity_id = ? ORDER BY elapsed_nanos ASC, id ASC;

deleteMedia:
DELETE FROM media WHERE id = ?;

setMediaCaption:
UPDATE media SET caption = ? WHERE id = ?;

setWeather:
UPDATE activity SET weather_temp_c = ?, weather_wind_kmh = ?, weather_wind_deg = ?, weather_code = ? WHERE id = ?;

insertSegment:
INSERT INTO segment(name, start_lat, start_lon, end_lat, end_lon, created_wall_millis)
VALUES (?, ?, ?, ?, ?, ?);

listSegments:
SELECT * FROM segment ORDER BY id ASC;

insertEffort:
INSERT INTO segment_effort(segment_id, activity_id, elapsed_nanos, created_wall_millis)
VALUES (?, ?, ?, ?);

effortExists:
SELECT count(*) FROM segment_effort WHERE segment_id = ? AND activity_id = ?;

bestEffort:
SELECT min(elapsed_nanos) AS best FROM segment_effort WHERE segment_id = ?;

effortsForActivity:
SELECT e.id, e.segment_id, e.elapsed_nanos, s.name
FROM segment_effort e JOIN segment s ON s.id = e.segment_id
WHERE e.activity_id = ? ORDER BY e.id ASC;

segmentStats:
SELECT s.id AS segment_id, s.name AS name, count(e.id) AS attempts, min(e.elapsed_nanos) AS best_nanos
FROM segment s LEFT JOIN segment_effort e ON e.segment_id = s.id
GROUP BY s.id, s.name
ORDER BY s.id ASC;

mediaPathsForActivity:
SELECT file_path FROM media WHERE activity_id = ?;

deleteMediaForActivity:
DELETE FROM media WHERE activity_id = ?;

deleteEffortsForActivity:
DELETE FROM segment_effort WHERE activity_id = ?;

deletePointsForActivity:
DELETE FROM track_point WHERE activity_id = ?;

deleteActivityRow:
DELETE FROM activity WHERE id = ?;
